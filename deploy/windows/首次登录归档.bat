@echo off
chcp 936 >nul
title 首次登录归档账号 - Telegram
cd /d "%~dp0"

echo.
echo   ============================================================
echo      首次登录归档账号（只需要做一次）
echo   ============================================================
echo.
echo      归档面板要用你自己真实的 Telegram 账号读取消息，
echo      所以要先在这里登录一次。登录状态会保存在本机，
echo      以后打开面板就不用再登录了。
echo.
echo      接下来需要：
echo        1. 你的手机号（国际格式，例如 +8613800000000）
echo        2. Telegram 发送到你手机的验证码
echo        3. 如果你开了两步验证，还要输入两步验证密码
echo.
echo      手机号的验证码会发到你的 Telegram 客户端里，
echo      不是在短信里，请注意查看 Telegram 消息。
echo.
echo   ------------------------------------------------------------
echo.
pause

tdl.exe archive login

echo.
echo   ============================================================
echo      登录流程结束
echo      如果上面显示登录成功，现在可以双击「启动归档面板.bat」
echo      如果报错，请把上面的红字截图发给提供软件的人
echo   ============================================================
echo.
pause >nul
