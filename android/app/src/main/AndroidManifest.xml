<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- keeps the Go core from being frozen while it holds the MTProto socket -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 长按消息时的触感反馈（navigator.vibrate）。缺权限时 WebView 静默忽略，
         不影响逻辑，但有了它手感才对。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 不声明这个，核心只在用户手动打开 App 之后才运行：重启手机或系统更新
         杀掉进程后就再也不归档了，直到有人再次点开 App。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TdlArchive">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TdlArchive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ArchiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
                specialUse rather than dataSync: Android 15 caps dataSync
                foreground services at 6 hours per day, which stops a 24/7
                archive cold. specialUse carries no time cap, and the declared
                subtype explains to the platform (and to a reviewer) why this
                service must run continuously.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_telegram_archive_sync" />
        </service>

        <!--
            把 cacheDir/shared 里的文件以 content:// 交给外部应用打开。
            Android 7 起 file:// 不能跨应用传，而 WebView 自己没有能力保存
            Content-Disposition: attachment 的响应（导出、/media/<sha> 都走这条）。
            exported=false + grantUriPermissions=true：只有拿到我们显式授予的
            临时权限的应用才能读，其它应用进不来。
        -->
        <provider
            android:name=".SharedFileProvider"
            android:authorities="com.tdl.archive.app.sharedfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
            exported=true is required and safe here: BOOT_COMPLETED /
            MY_PACKAGE_REPLACED are protected broadcasts that only the system
            may send, so no third-party app can trigger an autostart. Do not
            "fix" this to false — the receiver would stop firing and the archive
            would silently only run while the app is open.
            MY_PACKAGE_REPLACED covers the update case: after an APK install the
            old process is dead and nothing restarts the core on its own.
            QUICKBOOT_POWERON is the HTC/MTK variant some ROMs broadcast instead
            of BOOT_COMPLETED.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
