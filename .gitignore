.idea/
.vscode/
.DS_Store

# Only the runtime config at the repo root. deploy/windows/config.yaml is a
# shipped template that hack/build-windows.sh copies into the Windows package,
# so an unanchored rule silently dropped a file the release needs.
/config.yaml
.env
.env.*
!.env.example

.tdl/
data/
log/
downloads/

tdl
telegram-download-bot
tdl.bak-*
__debug_bin*
*.exe
*.test
*.out
dist/
coverage/

*.log
*.tmp
*.backup
.hugo_build.lock

# curl cookie jars created by "curl -c -o ..." end up named "-o" by accident;
# one of them leaked a session cookie into the repo.
/-o

.workbuddy/
.mimosa/
.zcode/
